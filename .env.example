# ============================================================
# Bot ISIB — variables d'environnement
# ============================================================
#
# Copie ce fichier en ".env" pour un lancement en local,
# et NE JAMAIS commit le fichier ".env" réel (il est ignoré
# par .gitignore).
#
# Sur Render, ces mêmes variables se configurent dans
# Dashboard → ton service → Environment (voir README.md).
# ============================================================

# --- Connexion à Discord ---
DISCORD_TOKEN=
GUILD_ID=

# --- Connexion à Brevo (envoi du mail de code de vérification) ---
BREVO_API_KEY=
EMAIL_SENDER=
EMAIL_SENDER_NAME=

# --- Salon audit (vérification visuelle des authentifications) ---
AUDIT_CHANNEL_ID=

# --- Salon interne où arrivent les demandes d'inscription académique ---
VALIDATION_CHANNEL_ID=

# --- Base de données PostgreSQL (Neon, gratuit) ---
# Récupère ces valeurs dans Neon -> Connect -> "Parameters only"
# (ou déduis-les de la connection string postgresql://USER:PASSWORD@HOST/DBNAME?...).
PGHOST=
PGPORT=5432
PGDATABASE=neondb
PGUSER=
PGPASSWORD=
PGSSLMODE=require
